# ── Docker Development Environment ──
# Service names used as hostnames inside the Docker network.
# NEXT_PUBLIC_API_URL uses localhost because the browser runs on the host.

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/haversack_dev

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Authentication ──
JWT_ACCESS_SECRET=dev-access-secret-do-not-use-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-do-not-use-in-production

# ── Application ──
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://backend:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
