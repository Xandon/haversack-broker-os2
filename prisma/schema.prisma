generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  rep
  logistics
  viewer
}

enum AuditAction {
  create
  update
  delete
}

enum AccountType {
  retail
  restaurant
  distributor
}

enum ActivityType {
  visit
  call
  email
  demo
  sampling
}

enum TaskPriority {
  high
  medium
  low
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum EmailDirection {
  inbound
  outbound
}

enum EmailStatus {
  sent
  delivered
  opened
  clicked
  bounced
  failed
}

enum NotificationType {
  task_reminder
  task_assigned
  task_overdue
  order_approval_required
  order_approved
  order_rejected
  order_export_failed
}

enum OrderStatus {
  draft
  pending_approval
  confirmed
  rejected
  cancelled
}

enum RevenueModel {
  broker
  wholesale
}

enum AvailabilityStatus {
  active
  seasonal
  discontinued
}

enum ApprovalDecision {
  approved
  rejected
}

enum ExportStatus {
  queued
  exported
  failed
}

enum PipelineStage {
  prospect
  qualified
  proposal
  negotiation
  closed_won
  closed_lost
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  territories      UserTerritory[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  loggedActivities Activity[]
  createdTasks     Task[]          @relation("TaskCreator")
  assignedTasks    Task[]          @relation("TaskAssignee")
  notifications    Notification[]
  emailRecords     EmailRecord[]
  createdOrders    Order[]          @relation("OrderCreator")
  approvals        OrderApproval[]
  opportunities    Opportunity[]
  commissionRulesCreated  CommissionRule[]      @relation("CommissionRuleCreator")
  commissionEntries       CommissionEntry[]     @relation("CommissionEntryRep")
  commissionStatements    CommissionStatement[] @relation("CommissionStatementRep")
  commissionApprovals     CommissionStatement[] @relation("CommissionStatementApprover")
  disputesFiled           CommissionDispute[]   @relation("CommissionDisputeFiler")
  disputesResolved        CommissionDispute[]   @relation("CommissionDisputeResolver")
  commissionExports       CommissionExport[]    @relation("CommissionExportCreator")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

model Territory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String   @db.VarChar(255)
  region             String   @db.VarChar(100)
  zipCodes           String[] @default([]) @map("zip_codes")
  boundary           Json?
  commissionModifier Decimal  @default(1.00) @map("commission_modifier") @db.Decimal(4, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users           UserTerritory[]
  accounts        Account[]
  commissionRules CommissionRule[]

  @@unique([tenantId, name])
  @@index([tenantId, region])
  @@map("territories")
}

model UserTerritory {
  userId      String   @map("user_id") @db.Uuid
  territoryId String   @map("territory_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@id([userId, territoryId])
  @@map("user_territories")
}

model AuditLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  actorId       String      @map("actor_id") @db.Uuid
  actorEmail    String      @map("actor_email") @db.VarChar(255)
  entityType    String      @map("entity_type") @db.VarChar(50)
  entityId      String      @map("entity_id") @db.Uuid
  action        AuditAction
  fieldName     String?     @map("field_name") @db.VarChar(100)
  oldValue      String?     @map("old_value") @db.Text
  newValue      String?     @map("new_value") @db.Text
  changeSummary Json?       @map("change_summary")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.VarChar(500)
  requestId     String?     @map("request_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Account {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String      @map("tenant_id") @db.Uuid
  name                    String      @db.VarChar(255)
  accountType             AccountType @map("account_type")
  streetAddress           String      @map("street_address") @db.VarChar(500)
  city                    String      @db.VarChar(100)
  state                   String      @db.VarChar(50)
  zipCode                 String      @map("zip_code") @db.VarChar(20)
  territoryId             String      @map("territory_id") @db.Uuid
  parentAccountId         String?     @map("parent_account_id") @db.Uuid
  healthScore             Int?        @map("health_score")
  healthScoreCalculatedAt DateTime?   @map("health_score_calculated_at") @db.Timestamptz()
  isActive                Boolean     @default(true) @map("is_active")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime?   @map("deleted_at") @db.Timestamptz()

  territory     Territory            @relation(fields: [territoryId], references: [id])
  parentAccount Account?             @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts Account[]            @relation("AccountHierarchy")
  contacts      Contact[]
  healthScores  AccountHealthScore[]
  activities    Activity[]
  tasks         Task[]
  emailRecords  EmailRecord[]
  orders        Order[]
  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@index([tenantId, territoryId])
  @@index([tenantId, accountType])
  @@index([tenantId, healthScore])
  @@index([tenantId, parentAccountId])
  @@index([tenantId, deletedAt])
  @@map("accounts")
}

model Contact {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  title     String?   @db.VarChar(100)
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  emailRecords EmailRecord[]
  tasks        Task[]

  @@index([tenantId, accountId])
  @@index([tenantId, email])
  @@map("contacts")
}

model AccountHealthScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  score           Int
  factorBreakdown Json     @map("factor_breakdown") @db.JsonB
  calculatedAt    DateTime @default(now()) @map("calculated_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, calculatedAt(sort: Desc)])
  @@index([tenantId, calculatedAt(sort: Desc)])
  @@map("account_health_scores")
}

model Activity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  accountId       String       @map("account_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  type            ActivityType
  notes           String?      @db.Text
  occurredAt      DateTime     @map("occurred_at") @db.Timestamptz()
  durationMinutes Int?         @map("duration_minutes")
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  demos   Demo[]

  @@index([tenantId, accountId, occurredAt(sort: Desc)])
  @@index([tenantId, userId, occurredAt(sort: Desc)])
  @@index([tenantId, type, occurredAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("activities")
}

model Demo {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  activityId      String   @map("activity_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantitySampled Int?     @map("quantity_sampled")
  buyerFeedback   String?  @map("buyer_feedback") @db.Text
  outcome         String?  @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([tenantId, productId])
  @@map("demos")
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
  dueDate     DateTime     @map("due_date") @db.Timestamptz()
  priority    TaskPriority
  status      TaskStatus   @default(pending)
  assigneeId  String       @map("assignee_id") @db.Uuid
  creatorId   String       @map("creator_id") @db.Uuid
  accountId   String?      @map("account_id") @db.Uuid
  contactId   String?      @map("contact_id") @db.Uuid
  completedAt DateTime?    @map("completed_at") @db.Timestamptz()
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz()

  assignee  User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator   User           @relation("TaskCreator", fields: [creatorId], references: [id])
  account   Account?       @relation(fields: [accountId], references: [id])
  contact   Contact?       @relation(fields: [contactId], references: [id])
  reminders TaskReminder[]

  @@index([tenantId, assigneeId, status, dueDate])
  @@index([tenantId, accountId, createdAt(sort: Desc)])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, deletedAt])
  @@map("tasks")
}

model TaskReminder {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  remindAt     DateTime  @map("remind_at") @db.Timestamptz()
  reminderType String    @map("reminder_type") @db.VarChar(10)
  isSent       Boolean   @default(false) @map("is_sent")
  sentAt       DateTime? @map("sent_at") @db.Timestamptz()
  bullmqJobId  String?   @map("bullmq_job_id") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([tenantId, isSent, remindAt])
  @@map("task_reminders")
}

model EmailRecord {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  contactId      String?        @map("contact_id") @db.Uuid
  accountId      String?        @map("account_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  subject        String         @db.VarChar(500)
  bodyPreview    String?        @map("body_preview") @db.VarChar(500)
  direction      EmailDirection
  status         EmailStatus    @default(sent)
  recipientEmail String         @map("recipient_email") @db.VarChar(255)
  openedAt       DateTime?      @map("opened_at") @db.Timestamptz()
  clickedAt      DateTime?      @map("clicked_at") @db.Timestamptz()
  bouncedAt      DateTime?      @map("bounced_at") @db.Timestamptz()
  sentAt         DateTime       @map("sent_at") @db.Timestamptz()
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  contact Contact? @relation(fields: [contactId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([tenantId, accountId, sentAt(sort: Desc)])
  @@index([tenantId, contactId, sentAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, recipientEmail])
  @@map("email_records")
}

model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  title         String           @db.VarChar(255)
  body          String?          @db.Text
  referenceId   String?          @map("reference_id") @db.Uuid
  referenceType String?          @map("reference_type") @db.VarChar(50)
  isRead        Boolean          @default(false) @map("is_read")
  readAt        DateTime?        @map("read_at") @db.Timestamptz()
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, isRead, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Brand {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(255)
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 2)
  description    String?  @db.VarChar(2000)
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  contactName    String?  @map("contact_name") @db.VarChar(255)
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  contactPhone   String?  @map("contact_phone") @db.VarChar(50)
  website        String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  products          Product[]
  vendorSubOrders   VendorSubOrder[]
  opportunityBrands OpportunityBrand[]
  commissionRules   CommissionRule[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("brands")
}

model Product {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  brandId               String             @map("brand_id") @db.Uuid
  name                  String             @db.VarChar(255)
  sku                   String             @db.VarChar(100)
  category              String?            @db.VarChar(50)
  subcategory           String?            @db.VarChar(100)
  description           String?            @db.VarChar(2000)
  unitPrice             Decimal            @map("unit_price") @db.Decimal(10, 2)
  wholesalePrice        Decimal?           @map("wholesale_price") @db.Decimal(10, 2)
  promotionalPrice      Decimal?           @map("promotional_price") @db.Decimal(10, 2)
  promotionalPriceStart DateTime?          @map("promotional_price_start") @db.Timestamptz()
  promotionalPriceEnd   DateTime?          @map("promotional_price_end") @db.Timestamptz()
  caseSize              Int?               @map("case_size")
  revenueModelDefault   RevenueModel       @map("revenue_model_default")
  availabilityStatus    AvailabilityStatus @map("availability_status") @default(active)
  imageUrl              String?            @map("image_url") @db.VarChar(500)
  certifications        String[]           @default([])
  allergens             String[]           @default([])
  dietaryAttributes     String[]           @default([]) @map("dietary_attributes")
  isActive              Boolean            @default(true) @map("is_active")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  brand     Brand           @relation(fields: [brandId], references: [id])
  lineItems OrderLineItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, brandId])
  @@index([tenantId, availabilityStatus])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("products")
}

model Order {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  orderNumber  String        @map("order_number") @db.VarChar(20)
  accountId    String        @map("account_id") @db.Uuid
  repId        String        @map("rep_id") @db.Uuid
  status       OrderStatus   @default(draft)
  subtotal     Decimal       @default(0) @db.Decimal(12, 2)
  tax          Decimal       @default(0) @db.Decimal(10, 2)
  total        Decimal       @default(0) @db.Decimal(12, 2)
  notes        String?       @db.Text
  submittedAt  DateTime?     @map("submitted_at") @db.Timestamptz()
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz()
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz()
  exportStatus ExportStatus? @map("export_status")
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  account          Account           @relation(fields: [accountId], references: [id])
  rep              User              @relation("OrderCreator", fields: [repId], references: [id])
  lineItems        OrderLineItem[]
  vendorSubOrders  VendorSubOrder[]
  approvals        OrderApproval[]
  quickBooksExport QuickBooksExport?
  commissionEntries CommissionEntry[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, accountId, createdAt(sort: Desc)])
  @@index([tenantId, repId, status])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, exportStatus])
  @@map("orders")
}

model OrderLineItem {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  orderId                String       @map("order_id") @db.Uuid
  productId              String       @map("product_id") @db.Uuid
  vendorSubOrderId       String?      @map("vendor_sub_order_id") @db.Uuid
  quantity               Int
  unitPrice              Decimal      @map("unit_price") @db.Decimal(10, 2)
  revenueModel           RevenueModel @map("revenue_model")
  commissionRate         Decimal?     @map("commission_rate") @db.Decimal(5, 2)
  discount               Decimal      @default(0) @db.Decimal(10, 2)
  lineTotal              Decimal      @map("line_total") @db.Decimal(12, 2)
  promotionalPriceApplied Boolean     @default(false) @map("promotional_price_applied")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])
  vendorSubOrder    VendorSubOrder?   @relation(fields: [vendorSubOrderId], references: [id])
  commissionEntries CommissionEntry[]

  @@index([orderId])
  @@index([tenantId, productId])
  @@map("order_line_items")
}

model VendorSubOrder {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  brandId           String   @map("brand_id") @db.Uuid
  subtotal          Decimal  @db.Decimal(12, 2)
  fulfillmentStatus String   @default("pending") @map("fulfillment_status") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand     Brand           @relation(fields: [brandId], references: [id])
  lineItems OrderLineItem[]

  @@index([orderId])
  @@index([tenantId, brandId])
  @@map("vendor_sub_orders")
}

model OrderApproval {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  approverId String           @map("approver_id") @db.Uuid
  decision   ApprovalDecision
  reason     String?          @db.Text
  decidedAt  DateTime         @map("decided_at") @db.Timestamptz()
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approver User  @relation(fields: [approverId], references: [id])

  @@index([orderId])
  @@index([tenantId, approverId, decidedAt(sort: Desc)])
  @@map("order_approvals")
}

model QuickBooksExport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  orderId       String       @unique @map("order_id") @db.Uuid
  status        ExportStatus
  attemptCount  Int          @default(0) @map("attempt_count")
  lastAttemptAt DateTime?    @map("last_attempt_at") @db.Timestamptz()
  errorDetails  String?      @map("error_details") @db.Text
  csvData       String?      @map("csv_data") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("quickbooks_exports")
}

model Opportunity {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  accountId         String        @map("account_id") @db.Uuid
  repId             String        @map("rep_id") @db.Uuid
  name              String        @db.VarChar(255)
  estimatedValue    Decimal       @map("estimated_value") @db.Decimal(12, 2)
  probability       Decimal       @db.Decimal(5, 2)
  expectedCloseDate DateTime      @map("expected_close_date") @db.Date
  stage             PipelineStage
  closeReason       String?       @map("close_reason") @db.Text
  closedAt          DateTime?     @map("closed_at") @db.Timestamptz()
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  account Account           @relation(fields: [accountId], references: [id])
  rep     User              @relation(fields: [repId], references: [id])
  brands  OpportunityBrand[]

  @@index([tenantId, stage])
  @@index([tenantId, repId])
  @@index([tenantId, accountId])
  @@index([tenantId, expectedCloseDate])
  @@map("opportunities")
}

model OpportunityBrand {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId String @map("opportunity_id") @db.Uuid
  brandId       String @map("brand_id") @db.Uuid

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  brand       Brand       @relation(fields: [brandId], references: [id])

  @@unique([opportunityId, brandId])
  @@map("opportunity_brands")
}

// ──────────────────────────────────────────────────────────────
// Commission entities (Feature 7 — FR-020, FR-021, FR-022)
// ──────────────────────────────────────────────────────────────

enum CommissionStatementStatus {
  pending
  approved
  exported
  paid
}

enum CommissionDisputeStatus {
  open
  resolved
}

enum CommissionEntryType {
  calculation
  reversal
  credit
}

model CommissionRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  brandId           String    @map("brand_id") @db.Uuid
  territoryId       String?   @map("territory_id") @db.Uuid
  baseRate          Decimal   @map("base_rate") @db.Decimal(5, 4)
  territoryModifier Decimal   @default(1.00) @map("territory_modifier") @db.Decimal(4, 2)
  volumeTiers       Json      @map("volume_tiers") @db.JsonB
  effectiveDate     DateTime  @map("effective_date") @db.Date
  expiresAt         DateTime? @map("expires_at") @db.Date
  isActive          Boolean   @default(true) @map("is_active")
  version           Int       @default(1)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  brand     Brand      @relation(fields: [brandId], references: [id])
  territory Territory? @relation(fields: [territoryId], references: [id])
  creator   User       @relation("CommissionRuleCreator", fields: [createdBy], references: [id])
  entries   CommissionEntry[]

  @@index([tenantId, brandId, effectiveDate])
  @@index([tenantId, brandId, territoryId, effectiveDate])
  @@index([tenantId, isActive])
  @@map("commission_rules")
}

model CommissionEntry {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  orderId           String              @map("order_id") @db.Uuid
  orderLineItemId   String              @map("order_line_item_id") @db.Uuid
  repId             String              @map("rep_id") @db.Uuid
  commissionRuleId  String              @map("commission_rule_id") @db.Uuid
  statementId       String?             @map("statement_id") @db.Uuid
  entryType         CommissionEntryType @default(calculation) @map("entry_type")
  baseRate          Decimal             @map("base_rate") @db.Decimal(5, 4)
  territoryModifier Decimal             @map("territory_modifier") @db.Decimal(4, 2)
  volumeTierApplied String              @map("volume_tier_applied") @db.VarChar(100)
  effectiveRate     Decimal             @map("effective_rate") @db.Decimal(5, 4)
  lineItemTotal     Decimal             @map("line_item_total") @db.Decimal(12, 2)
  commissionAmount  Decimal             @map("commission_amount") @db.Decimal(12, 2)
  calculatedAt      DateTime            @map("calculated_at") @db.Timestamptz()
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  order         Order         @relation(fields: [orderId], references: [id])
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id])
  rep            User                 @relation("CommissionEntryRep", fields: [repId], references: [id])
  commissionRule CommissionRule       @relation(fields: [commissionRuleId], references: [id])
  statement      CommissionStatement? @relation(fields: [statementId], references: [id])
  dispute        CommissionDispute?

  @@index([tenantId, repId, calculatedAt(sort: Desc)])
  @@index([tenantId, orderId])
  @@index([tenantId, statementId])
  @@map("commission_entries")
}

model CommissionStatement {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  repId       String                    @map("rep_id") @db.Uuid
  month       Int
  year        Int
  status      CommissionStatementStatus @default(pending)
  totalEarned Decimal                   @default(0) @map("total_earned") @db.Decimal(12, 2)
  ytdTotal    Decimal                   @default(0) @map("ytd_total") @db.Decimal(12, 2)
  approvedBy  String?                   @map("approved_by") @db.Uuid
  approvedAt  DateTime?                 @map("approved_at") @db.Timestamptz()
  exportedAt  DateTime?                 @map("exported_at") @db.Timestamptz()
  version     Int                       @default(1)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  rep      User                @relation("CommissionStatementRep", fields: [repId], references: [id])
  approver User?               @relation("CommissionStatementApprover", fields: [approvedBy], references: [id])
  entries  CommissionEntry[]
  disputes CommissionDispute[]
  exports  CommissionExport[]  @relation("CommissionExportStatements")

  @@unique([tenantId, repId, year, month])
  @@index([tenantId, status])
  @@map("commission_statements")
}

model CommissionDispute {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  statementId       String                  @map("statement_id") @db.Uuid
  commissionEntryId String                  @unique @map("commission_entry_id") @db.Uuid
  filedBy           String                  @map("filed_by") @db.Uuid
  reason            String                  @db.VarChar(1000)
  status            CommissionDisputeStatus @default(open)
  originalAmount    Decimal                 @map("original_amount") @db.Decimal(12, 2)
  adjustedAmount    Decimal?                @map("adjusted_amount") @db.Decimal(12, 2)
  resolvedBy        String?                 @map("resolved_by") @db.Uuid
  resolvedAt        DateTime?               @map("resolved_at") @db.Timestamptz()
  resolutionNotes   String?                 @map("resolution_notes") @db.VarChar(1000)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  statement       CommissionStatement @relation(fields: [statementId], references: [id])
  commissionEntry CommissionEntry     @relation(fields: [commissionEntryId], references: [id])
  filer           User                @relation("CommissionDisputeFiler", fields: [filedBy], references: [id])
  resolver        User?               @relation("CommissionDisputeResolver", fields: [resolvedBy], references: [id])

  @@index([tenantId, statementId, status])
  @@map("commission_disputes")
}

model CommissionExport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  month        Int
  year         Int
  format       String   @default("quickbooks_csv") @db.VarChar(50)
  fileContent  String   @map("file_content") @db.Text
  referenceId  String   @unique @map("reference_id") @db.VarChar(50)
  status       String   @default("completed") @db.VarChar(20)
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  creator    User                  @relation("CommissionExportCreator", fields: [createdBy], references: [id])
  statements CommissionStatement[] @relation("CommissionExportStatements")

  @@index([tenantId, year, month])
  @@map("commission_exports")
}
