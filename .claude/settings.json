{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd backend && npx vitest run --passWithNoTests --reporter=min 2>&1 | tail -20"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --no-error-on-unmatched-pattern $(git diff --name-only --diff-filter=M '*.ts' '*.tsx' 2>/dev/null) 2>&1 | tail -10"
          }
        ]
      }
    ]
  }
}
