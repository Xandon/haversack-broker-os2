{
  "name": "@haversack/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Haversack Unified Platform — Next.js App Router frontend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
