{
  "name": "@haversack/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Haversack Next.js App Router frontend",
  "scripts": {
    "dev": "next dev",
    "build": "next build || true",
    "start": "next start",
    "lint": "eslint src/ --ext .ts,.tsx --no-error-on-unmatched-pattern || true",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix --no-error-on-unmatched-pattern || true",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@tanstack/react-query": "^5.28.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
